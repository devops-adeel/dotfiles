# Node.js/NVM optimizations for M3 Pro
export NVM_DIR="$HOME/.nvm"
export NODE_OPTIONS="--max-old-space-size=32768"  # Use more memory for Node.js (32GB available)

# Lazy load NVM for faster shell startup (already configured above)
# Only load when actually needed
nvm() {
  unset -f nvm
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  nvm "$@"
}

